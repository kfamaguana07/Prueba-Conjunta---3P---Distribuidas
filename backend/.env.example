# Base de datos PostgreSQL de CavaLocal
DATABASE_URL=postgresql://cavalocal:cavalocal@localhost:5432/cavalocal?schema=public

# JWT
JWT_SECRET=cambiame-por-un-secreto-largo
JWT_EXPIRES_IN=7d

# CORS (orígenes separados por coma, o * para todos)
CORS_ORIGINS=*

# Google OAuth (opcional: login con Google)
GOOGLE_CLIENT_ID=

# Mail (Nodemailer + Gmail, opcional: factura y reset)
MAIL_USER=
MAIL_APP_PASSWORD=
WEB_BASE_URL=http://localhost:8081

# RabbitMQ (auditoría asíncrona hacia ms-audit)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=audit_user
RABBITMQ_PASSWORD=audit_pass
RABBITMQ_EXCHANGE=audit_exchange
RABBITMQ_QUEUE=audit_queue
RABBITMQ_ROUTING_KEY=audit.event