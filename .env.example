# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=espe
POSTGRES_PASSWORD=espe123
POSTGRES_DB=cavalocal
POSTGRES_PORT=5432

# ── Backend NestJS ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://espe:espe123@postgres:5432/cavalocal?schema=public
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=1d
CORS_ORIGINS=*

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Correo Gmail SMTP (opcional) ──────────────────────────────────────────────
MAIL_USER=
MAIL_APP_PASSWORD=

# ── App Expo (accedidas desde el navegador del usuario) ───────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_LANDING_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
